{
  "name": "lascii",
  "version": "2.0.0",
  "description": "Lightweight ASCII animation effects for the web",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./auto": {
      "import": {
        "types": "./dist/auto.d.ts",
        "default": "./dist/auto.js"
      },
      "require": {
        "types": "./dist/auto.d.cts",
        "default": "./dist/auto.cjs"
      },
      "default": "./dist/auto.js"
    },
    "./dom": {
      "import": {
        "types": "./dist/dom/index.d.ts",
        "default": "./dist/dom/index.js"
      },
      "require": {
        "types": "./dist/dom/index.d.cts",
        "default": "./dist/dom/index.cjs"
      },
      "default": "./dist/dom/index.js"
    },
    "./core/text": {
      "import": {
        "types": "./dist/core/text/index.d.ts",
        "default": "./dist/core/text/index.js"
      },
      "require": {
        "types": "./dist/core/text/index.d.cts",
        "default": "./dist/core/text/index.cjs"
      },
      "default": "./dist/core/text/index.js"
    },
    "./core/image": {
      "import": {
        "types": "./dist/core/image/index.d.ts",
        "default": "./dist/core/image/index.js"
      },
      "require": {
        "types": "./dist/core/image/index.d.cts",
        "default": "./dist/core/image/index.cjs"
      },
      "default": "./dist/core/image/index.js"
    }
  },
  "sideEffects": [
    "./dist/auto.js",
    "./dist/auto.cjs"
  ],
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "prepare": "npm run build"
  },
  "keywords": [
    "ascii",
    "animation",
    "effect",
    "dom",
    "canvas",
    "text-effect"
  ],
  "license": "MIT",
  "author": "Gabriel Ramos (https://github.com/whosramoss)",
  "homepage": "https://lascii.whosramoss.com",
  "bugs": {
    "url": "https://github.com/whosramoss/lascii/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whosramoss/lascii.git"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
